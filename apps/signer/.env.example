# apps/signer: the only service holding FORGE keys (VPS 2). Names only: never commit values.
# Production: `pnpm --filter @forge/signer start` (= `tsx src/index.ts`, no file watcher), under a
# process supervisor that restarts it. `dev` (tsx watch) is for local development only.
# First setup: `tsx src/index.ts --init-keys` creates the payer, cashbox, buyback and revenue
# wallets in the keystore and prints their PUBLIC addresses. Operator: `tsx src/index.ts
# --revoke-launch <jobId>`
# invalidates a handed-out launch transaction (advances its durable nonce).
# Back up SIGNER_KEYSTORE_DIR and SIGNER_JOURNAL_DIR together: the journals make every payment
# and account creation happen at most once.

# --- Cluster and services -------------------------------------------------------------------
# devnet (default) or mainnet-beta. The RPC genesis hash is checked against it at startup.
SOLANA_CLUSTER=devnet
RPC_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Operator alerts. Required on mainnet-beta and in production (NODE_ENV other than development /
# test): the signer refuses to start without both, an alert that only reaches the log is lost.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Jupiter developer portal key, shared by the fee conversion and the buyback. Required (startup
# error without it) when either runs live: FORGE_CONVERT_LIVE=true or FORGE_BUYBACK_LIVE=true on
# mainnet-beta. Dry runs and simulations work without it.
JUPITER_API_KEY=
# Optional, shared by the fee conversion and the buyback (default https://api.jup.ag/swap/v1).
JUPITER_API_URL=

# --- FORGE addresses (read by @forge/core requireAddresses; startup fails if one is invalid) -
FORGE_MULTISIG_VAULT=
# Must be the public key of the keystore `cashbox` wallet.
FORGE_CASHBOX_WALLET=
# Revenue wallet (D34): the public key of the keystore `revenue` wallet. It receives the platform
# fee, holds the Meteora referral account and is the Jupiter referral partner; the revenue job
# converts what it holds to SOL and forwards it to the vault. On mainnet-beta the signer refuses
# to start when the key, FORGE_PLATFORM_FEE_WALLET or the referral account owner disagree with it
# (high alert `revenue_wiring` on devnet, the revenue job then stays off).
FORGE_REVENUE_WALLET=
# Must be FORGE_REVENUE_WALLET (the platform fee is revenue).
FORGE_PLATFORM_FEE_WALLET=
# FORGE Meteora referral token account (WSOL, rent-exempt, held by FORGE_REVENUE_WALLET): checked
# at startup and watched. Create it as a standalone WSOL token account of the revenue wallet, not
# its associated account (the Jupiter claims land there and would be booked as Meteora referral).
# It is NOT passed to the launchpad coin first buy: a first buy with a referral loses the
# first-swap minimum fee and fails on slippage (devnet finding, routes/onchain.ts).
FORGE_METEORA_REFERRAL_ACCOUNT=
# A named referral account of Jupiter's Ultra project (DkiqsTrw1u1bYFumumC7sCG2S8K25qc2vemJFHyW2wJc),
# created on referral.jup.ag, whose partner is FORGE_REVENUE_WALLET: the claims job refuses any
# other (immediate alert).
FORGE_JUPITER_REFERRAL_ACCOUNT=
# Optional: absent before the $FORGE launch (buyback in simulation).
FORGE_MINT=

# --- Keystore and journals ------------------------------------------------------------------
# At least 32 characters, no surrounding whitespace. Removed from the process environment (with
# SUPABASE_SERVICE_ROLE_KEY) as soon as it is parsed; set LimitCORE=0 in the service unit too.
SIGNER_KEYSTORE_PASSPHRASE=
SIGNER_KEYSTORE_DIR=./keystore
# Also holds the instance lock (signer.lock: one signer, or one operator command, at a time) and
# the append-only refund ledger (refund-ledger.*.json: never delete these files).
SIGNER_JOURNAL_DIR=./journal

# --- Private HMAC API (builder -> signer) ----------------------------------------------------
# At least 32 bytes; same value as the builder's.
SIGNER_HMAC_SECRET=
# Builder (VPS 1) IPs, comma separated. Empty in production = every request refused.
SIGNER_ALLOWED_IPS=
# Bind address (default 0.0.0.0, the IP allowlist decides) and port (default 8787).
SIGNER_HOST=
SIGNER_PORT=
# The builder's base URL of this service (used by the builder, listed for reference).
SIGNER_URL=
# development / test relax the empty-allowlist rule to loopback only; anything else = production.
NODE_ENV=production
LOG_LEVEL=info
# Bounded wait for requests and job runs in progress at shutdown (default 120).
SIGNER_SHUTDOWN_TIMEOUT_SECONDS=120

# --- Signing routes (/v1/configs, /v1/launch-coin/prepare) -----------------------------------
# Metadata URI of the launchpad coin, with exactly one {slug} or {launchpadId}; a canonical https
# URL of at most 106 bytes with the longest value (slug 32, launchpadId 36 characters), so that it
# fits the launch transaction next to a 32-byte name and a 10-byte symbol. Checked at startup.
SIGNER_COIN_METADATA_URL=
# Priority fee of the config and nonce account creations (micro-lamports per CU, default 0).
SIGNER_PRIORITY_FEE_MICRO_LAMPORTS=0
# Local kill switch on top of the `deploys_paused` flag (both fail closed).
SIGNER_ROUTES_PAUSED=false
# New launchpads the routes create accounts for (configs, nonce) per UTC day (default 20, at most
# 1000). Past it, new launchpads are refused (503) and alerted; admitted ones always go through.
# Before any payer spend, the creation payment is verified on-chain (finalized, exact amount from
# the owner to FORGE_CASHBOX_WALLET, memo forge:job:<jobId>).
SIGNER_MAX_LAUNCHPADS_PER_DAY=20
# Floors on the payment rows the signer acts on (lamports, per kind), on top of the on-chain
# proof: the amount of a row is the database's word alone. A confirmed payment below its floor is
# refused by the routes (nothing spent, alert) and left to manual handling by the refunds job;
# usd_amount must also equal the shared price of the kind (33 for a creation, 5.5 for a
# modification). Defaults (leave empty): the price of the kind at the web's highest quotable SOL
# price (SOL_USD_PRICE_MAX, $5 000) with a 10% margin, i.e. 5940000 (0.00594 SOL) for a creation
# and 990000 (0.00099 SOL) for a modification; a real quote is never below them. A floor above the
# smallest real quote refuses legitimate payments: lower the floors before the web's
# SOL_USD_PRICE_MAX is raised or a price is lowered, and raise them only after the reverse.
SIGNER_MIN_CREATION_PAYMENT_LAMPORTS=
SIGNER_MIN_MODIFICATION_PAYMENT_LAMPORTS=

# --- Creator fee claims (1 h) ----------------------------------------------------------------
# Every run reads each launchpad coin pool and claims to FORGE_MULTISIG_VAULT, above the
# threshold: the DBC creator share and, once the pool has migrated to DAMM v2, the fees of the
# creator's permanently locked position (SOL unwrapped to the vault). The payer (or the creator)
# funds the temporary WSOL account of a position claim; its rent reaches the vault with the fees.
# The DBC share is claimed from SIGNER_CLAIMS_MIN_LAMPORTS (0.01 SOL). The position fees have
# their own, higher threshold, SIGNER_CLAIMS_MIN_POSITION_LAMPORTS (default 0.05 SOL): every
# position claim costs the payer the rent of the temporary WSOL account (about 0.002 SOL).
SIGNER_CLAIMS_MIN_LAMPORTS=10000000
SIGNER_CLAIMS_MIN_POSITION_LAMPORTS=50000000
# payer (default) or creator.
SIGNER_CLAIMS_FEE_PAYER=payer
SIGNER_CLAIMS_INTERVAL_HOURS=1
SIGNER_CLAIMS_PAUSED=false

# --- Jupiter referral fee claims (24 h; mainnet-beta only, wired off on devnet) ---------------
# Claims the plugin fees collected by the Jupiter referral program for
# FORGE_JUPITER_REFERRAL_ACCOUNT to FORGE_REVENUE_WALLET (its partner). Mints, comma separated,
# each as <mint> or <mint>:<minimum raw units to claim>; wrapped SOL and USDC may omit the
# threshold. Empty = wrapped SOL from 0.01 SOL and USDC from 1 USDC. The payer wallet pays the
# network fee and, once per mint, the revenue wallet's token account rent. Kill switch: the
# `jupiter_claims_paused` flag (fail closed) and SIGNER_JUPITER_CLAIMS_PAUSED. The revenue job
# books the conversion of these mints as `jupiter_referral`.
SIGNER_JUPITER_CLAIMS_MINTS=
SIGNER_JUPITER_CLAIMS_INTERVAL_HOURS=24
SIGNER_JUPITER_CLAIMS_PAUSED=false

# --- Cashbox sweep to the multisig (24 h) -----------------------------------------------------
SIGNER_CASHBOX_RESERVE_LAMPORTS=100000000
SIGNER_CASHBOX_MIN_SWEEP_LAMPORTS=100000000
SIGNER_CASHBOX_MAX_SWEEP_LAMPORTS=
# true by default: sweeping must be enabled explicitly.
SIGNER_CASHBOX_DRY_RUN=true
SIGNER_CASHBOX_INTERVAL_HOURS=24
SIGNER_CASHBOX_PAUSED=false

# --- Refunds (failed builds) ------------------------------------------------------------------
SIGNER_REFUNDS_MAX_LAMPORTS=2000000000
SIGNER_REFUNDS_INTERVAL_MINUTES=5
SIGNER_REFUNDS_PAUSED=false

# --- On-chain monitoring ----------------------------------------------------------------------
WATCH_INTERVAL_MS=60000
WATCH_MAX_BACKOFF_MS=900000
WATCH_RPC_ERROR_STREAK=5
WATCH_OUTFLOW_TOLERANCE_LAMPORTS=20000
WATCH_SIGNATURE_LIMIT=50
WATCH_MAX_SIGNATURE_PAGES=20
WATCH_MIN_VAULT_LAMPORTS=0
WATCH_MIN_PLATFORM_FEE_LAMPORTS=0
WATCH_MIN_CASHBOX_LAMPORTS=100000000
WATCH_MIN_PAYER_LAMPORTS=200000000
# Creator wallets hold no SOL by design (read-only signers) while SIGNER_CLAIMS_FEE_PAYER=payer:
# the default is then 0 (no low-balance alert); it is 0.005 SOL when the creators pay their claims.
WATCH_MIN_CREATOR_LAMPORTS=0
# The buyback bot wallet is empty until the buyback goes live: 0 disables its low-balance alert
# (its outflows are watched regardless, like the vault, the cashbox and the payer wallet).
WATCH_MIN_BUYBACK_LAMPORTS=0
# The revenue wallet keeps rent plus SIGNER_REVENUE_RESERVE_LAMPORTS; alert below this (default
# 0.005 SOL). Its outflows are watched with the vault as the only allowed destination; as the
# platform fee wallet it is one watched entry, not two.
WATCH_MIN_REVENUE_LAMPORTS=5000000

# --- Fee conversion to SOL (dry run unless mainnet-beta and FORGE_CONVERT_LIVE=true) ---------
# Kill switch: the `convert_paused` flag (migration 0015), fail closed (a missing row pauses the
# job with a high alert), read at every run and again before each swap is signed.
FORGE_CONVERT_LIVE=false
# Keystore wallets whose fee balances are converted: cashbox and/or payer (never buyback).
SIGNER_CONVERT_ROLES=cashbox
SIGNER_CONVERT_INTERVAL_HOURS=24
CONVERT_SLIPPAGE_BPS=50
CONVERT_MAX_SLIPPAGE_BPS=100
CONVERT_MAX_PRICE_IMPACT_BPS=100
CONVERT_MIN_OUTPUT_LAMPORTS=10000000
# Raw input units swapped at most per mint and run (default 1000000000 = 1,000 USDC); 0 = no cap.
CONVERT_MAX_INPUT_AMOUNT=1000000000
CONVERT_MAX_PRIORITY_FEE_LAMPORTS=1000000
CONVERT_REQUEST_INTERVAL_MS=1100
CONVERT_REQUEST_TIMEOUT_MS=15000
CONVERT_EXCLUDED_MINTS=

# --- Revenue wallet: unwrap, convert and forward the trading revenue to the vault (24 h) --------
# Every run reads the revenue wallet (FORGE_REVENUE_WALLET): the native SOL (platform fee), the
# wrapped SOL of the Meteora referral account and of its other WSOL accounts (Jupiter claims), and
# its other token balances (Jupiter claims in USDC or any other currency). The wrapped SOL is
# unwrapped through an ephemeral account (the referral account is never closed), the other
# balances are swapped to SOL on mainnet-beta with the conversion settings above (CONVERT_*,
# FORGE_CONVERT_LIVE, `convert_paused`; devnet: skipped, Jupiter does not index it), and the native
# SOL above rent + the reserve + a fee buffer is forwarded to FORGE_MULTISIG_VAULT, the only
# destination the policy accepts, from SIGNER_REVENUE_MIN_FORWARD_LAMPORTS. Every forward is
# written to SIGNER_JOURNAL_DIR/revenue-forward.<signature>.json (append-only, with a breakdown by
# source: meteora_referral, jupiter_referral, platform_fee, other) for the buyback budget.
# Kill switch: the `revenue_paused` flag (migration 0016), fail closed (a missing row pauses the
# job with a high alert), read before the run and again before each signature.
# Kept on the wallet on top of the rent-exempt minimum (default 0.01 SOL: the ephemeral account's
# rent, about 0.002 SOL, is advanced from it and returned in the same transaction).
SIGNER_REVENUE_RESERVE_LAMPORTS=10000000
# Forward only when the excess reaches this amount (default 0.01 SOL).
SIGNER_REVENUE_MIN_FORWARD_LAMPORTS=10000000
# Unwrap only when the wrapped SOL total reaches this amount (default 0.001 SOL: fee vs dust).
SIGNER_REVENUE_MIN_UNWRAP_LAMPORTS=1000000
# A drop of the native balance between two runs beyond this (the job's own fees), not explained by
# a forward, raises `revenue_unexpected_outflow` (default 0.0001 SOL; raise it with the priority fee).
SIGNER_REVENUE_OUTFLOW_TOLERANCE_LAMPORTS=100000
# true by default: unwrapping and forwarding must be enabled explicitly (dry run plans and logs).
SIGNER_REVENUE_DRY_RUN=true
SIGNER_REVENUE_INTERVAL_HOURS=24
SIGNER_REVENUE_PAUSED=false

# --- Squads v4 spending limit of the buyback bot (read by @forge/core readSquadsAddresses, the
# vault derived and checked in jobs/squads.ts) ------------------------------------------------
# Both or none. The multisig account and its SOL spending limit account for the `buyback` keystore
# wallet: period Day, members = the buyback wallet only, destinations = the buyback wallet only,
# amount = the daily buyback budget; the buyback wallet is a multisig member with NO permission.
# The vault derived from the multisig and FORGE_SQUADS_VAULT_INDEX (default 0, leave empty
# unless the treasury vault is not vault 0) must be FORGE_MULTISIG_VAULT (startup error
# otherwise). Without them the buyback has no withdrawer and stays in simulation.
FORGE_SQUADS_MULTISIG=
FORGE_SQUADS_SPENDING_LIMIT=
FORGE_SQUADS_VAULT_INDEX=

# --- $FORGE buyback (simulation unless FORGE_BUYBACK_LIVE=true, FORGE_MINT, the Squads spending
# limit above, and either mainnet-beta with BUYBACK_ROUTE=jupiter or devnet with
# FORGE_BUYBACK_DEVNET_TEST=true and BUYBACK_ROUTE=dbc-devnet; a live request that cannot be
# honoured is refused at startup) ------------------------------------------------------------
# A refused buyback configuration disables the buyback alone (high alert job_module_disabled),
# except on mainnet-beta with FORGE_BUYBACK_LIVE set (any value but false): there the signer
# refuses to start.
FORGE_BUYBACK_LIVE=false
# jupiter (default; the only route accepted on mainnet-beta) or dbc-devnet (devnet only: core
# buildBuyTx on the DBC pool of the stand-in coin, BUYBACK_DEVNET_DBC_POOL required).
BUYBACK_ROUTE=jupiter
# Devnet live gate for the buyback proof (scripts/devnet-tests signer:buyback). Setting it on
# mainnet-beta is a startup error: it can never loosen mainnet.
FORGE_BUYBACK_DEVNET_TEST=false
BUYBACK_DEVNET_DBC_POOL=
BUYBACK_DAILY_CAP_LAMPORTS=0
BUYBACK_ORDERS_PER_DAY=8
BUYBACK_MIN_ORDER_LAMPORTS=10000000
BUYBACK_MAX_ORDER_LAMPORTS=250000000
BUYBACK_SLIPPAGE_BPS=50
BUYBACK_MAX_PRICE_IMPACT_BPS=100
BUYBACK_FEE_RESERVE_LAMPORTS=20000000
BUYBACK_MAX_LATENESS_MINUTES=30
BUYBACK_DAY_MARGIN_MINUTES=10
BUYBACK_MAX_PRIORITY_FEE_LAMPORTS=100000
# Withdrawn on top of each planned order for its fees (default: the priority fee cap + 10 000;
# the dbc-devnet route adds the 30 bps platform fee of the largest order).
BUYBACK_ORDER_FEE_ALLOWANCE_LAMPORTS=
BUYBACK_TICK_SECONDS=60
BUYBACK_PAUSED=false
BUYBACK_REQUEST_INTERVAL_MS=1100
BUYBACK_REQUEST_TIMEOUT_MS=15000
