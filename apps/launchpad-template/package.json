{
  "name": "@forge/launchpad-template",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "description": "Client launchpad site template, forked from Meteora's fun-launch scaffold.",
  "scripts": {
    "clean": "node -e \"for (const d of ['.next','.turbo']) require('fs').rmSync(d,{recursive:true,force:true})\"",
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint ."
  },
  "dependencies": {
    "@forge/shared": "workspace:*",
    "@aws-sdk/client-s3": "3.1147.0",
    "@coral-xyz/anchor": "0.31.1",
    "@iconify-json/ic": "1.2.4",
    "@iconify-json/ph": "1.2.2",
    "@iconify-json/solar": "1.2.13",
    "@iconify/tailwind": "1.2.0",
    "@jup-ag/wallet-adapter": "0.2.6",
    "@meteora-ag/dynamic-bonding-curve-sdk": "1.5.13",
    "@solana/spl-token": "0.4.15",
    "@solana/wallet-adapter-phantom": "0.9.30",
    "@solana/wallet-adapter-solflare": "0.6.34",
    "@solana/web3.js": "1.99.0",
    "@tailwindcss/cli": "4.3.3",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "4.44.0",
    "@tanstack/react-table": "8.21.3",
    "@tanstack/react-virtual": "3.14.13",
    "@tanstack/zod-form-adapter": "0.42.1",
    "bn.js": "5.2.5",
    "bs58": "6.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "decimal.js": "10.6.0",
    "jotai": "2.20.3",
    "ky": "1.14.3",
    "next": "15.5.27",
    "next-themes": "0.4.6",
    "radix-ui": "1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-use": "17.6.1",
    "sonner": "2.0.8",
    "superstruct": "2.0.2",
    "tailwind-merge": "3.7.0",
    "tailwindcss-animate": "1.0.7",
    "zod": "3.25.76"
