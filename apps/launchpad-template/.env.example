# FORGE client site - environment variables. Never commit a real .env file.

# Cluster: devnet (default) or mainnet-beta
SOLANA_CLUSTER=devnet

# Solana RPC URL (server side only, used by /api/send-transaction and /api/upload)
RPC_URL=your_rpc_url

# Meteora pool config key of this launchpad (upstream name). Server side.
POOL_CONFIG_KEY=your_pool_config_key
# Same value, exposed to the browser to filter the coin lists (upstream name)
NEXT_PUBLIC_POOL_CONFIG_KEY=your_pool_config_key

# Jupiter API key (developer portal)
JUPITER_API_KEY=your_jupiter_api_key

# Cloudflare R2 (coin images and metadata)
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_ACCOUNT_ID=your_r2_account_id
R2_BUCKET=your_r2_bucket_name
# Public base URL of the bucket (used for image/metadata links and the CSP img-src allowlist)
R2_PUBLIC_URL=https://your-public-bucket-url.example

# FORGE addresses, read through @forge/core (injected by FORGE, not set by hand)
FORGE_MULTISIG_VAULT=
FORGE_METEORA_REFERRAL_ACCOUNT=
FORGE_PLATFORM_FEE_WALLET=
FORGE_JUPITER_REFERRAL_ACCOUNT=

# Placeholder: origin of the FORGE RPC relay, added to the CSP connect-src allowlist
NEXT_PUBLIC_FORGE_RPC_RELAY_URL=
