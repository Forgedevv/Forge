# FORGE client site - environment variables. Never commit a real .env file.
#
# The site holds NO secret: no RPC provider URL or key, no storage write key, no Jupiter API key.
# Every value below is injected by FORGE into the client project and is public, except
# FORGE_RPC_RELAY_TOKEN (server only; it grants nothing but a rate limit tier). Values prefixed
# NEXT_PUBLIC_ are inlined in the browser bundle at build time: set them before `next build`.

# Cluster: devnet (default) or mainnet-beta. NEXT_PUBLIC_ copy for the browser.
SOLANA_CLUSTER=devnet
NEXT_PUBLIC_SOLANA_CLUSTER=devnet

# FORGE RPC relay (apps/web `POST /api/rpc`). A bare origin gets `/api/rpc` appended. Used by the
# browser (trade, creation, claims) and by the server route /api/upload (pool transaction, rent).
# Also added to the CSP connect-src allowlist. Without it, trading and coin creation are disabled.
NEXT_PUBLIC_FORGE_RPC_RELAY_URL=https://forge.example

# Optional, SERVER ONLY (never prefix it with NEXT_PUBLIC_): per-launchpad server token, injected by
# FORGE. The /api/upload route sends it as the X-Forge-Relay-Token header to the RPC relay and to the
# FORGE upload endpoint (per-launchpad rate limit instead of the shared per-IP one). Never sent to
# the browser or to storage. Leave empty when FORGE did not provide one.
FORGE_RPC_RELAY_TOKEN=

# Optional: base URL of the FORGE API (presigned coin uploads,
# `POST /api/launchpads/<slug>/uploads`). Defaults to the origin of the RPC relay URL.
# Without a usable value, /api/upload answers 503 and stores nothing.
NEXT_PUBLIC_FORGE_API_URL=

# Meteora pool config key of this launchpad (public address). Filters the coin lists.
NEXT_PUBLIC_POOL_CONFIG_KEY=your_pool_config_key

# Public base URL of the coin images and metadata (read only). Used for the CSP img-src allowlist and
# to check the public URLs returned by the FORGE upload endpoint.
R2_PUBLIC_URL=https://your-public-bucket-url.example
NEXT_PUBLIC_R2_PUBLIC_URL=https://your-public-bucket-url.example

# FORGE public addresses (injected by FORGE, not set by hand). The browser only sees the
# NEXT_PUBLIC_ copies; the plain FORGE_ names are read on the server and in tests.
#   Jupiter referral account: integrator fee after graduation (30 bps).
#   Platform fee wallet: only recipient of the 0.3% transfer in a curve swap (must be rent-exempt).
#   Meteora referral account: WSOL token account used by every curve swap.
FORGE_JUPITER_REFERRAL_ACCOUNT=
FORGE_PLATFORM_FEE_WALLET=
FORGE_METEORA_REFERRAL_ACCOUNT=
NEXT_PUBLIC_FORGE_JUPITER_REFERRAL_ACCOUNT=
NEXT_PUBLIC_FORGE_PLATFORM_FEE_WALLET=
NEXT_PUBLIC_FORGE_METEORA_REFERRAL_ACCOUNT=
