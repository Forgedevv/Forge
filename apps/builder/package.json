{
  "name": "@forge/builder",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts/site-test",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint .",
    "site-test": "tsx scripts/site-test/cli.ts"
  },
  "dependencies": {
    "@forge/core": "workspace:*",
    "@forge/shared": "workspace:*",
    "pino": "10.4.0",
    "typescript": "6.0.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "tsx": "4.23.15"
  }
}
