# apps/builder (VPS 1): worker + pipelines, model gateway, sandbox, sleep cycle.
# Validated at start-up (src/index.ts, zod): the process refuses to start and names the
# missing or invalid variables (never their values). Empty lines count as unset.
# Secrets come from the environment only; never commit a filled copy of this file.

# --- Cluster ----------------------------------------------------------------------------------
# devnet (default) or mainnet-beta. Also given to every client project.
SOLANA_CLUSTER=devnet

# --- Supabase (service role, VPS only) ----------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Worker (src/worker/config.ts) -------------------------------------------------------------
# Optional: stable worker id (default builder-<host>-<pid>-<random>).
BUILDER_WORKER_ID=
# Jobs run at the same time (1 to 8, default 1).
BUILDER_CONCURRENCY=1
# Delay between polls when idle, ms (default 5000).
BUILDER_POLL_INTERVAL_MS=5000
# debug | info | warn | error
BUILDER_LOG_LEVEL=info

# --- Model gateway (src/gateway): the only holder of the real API key --------------------------
ANTHROPIC_API_KEY=
# Listen address. On Linux: the docker0 address (usually 172.17.0.1), never 0.0.0.0.
# On Docker Desktop: 127.0.0.1 works (default).
FORGE_GATEWAY_HOST=127.0.0.1
FORGE_GATEWAY_PORT=8787
# Default https://api.anthropic.com
FORGE_GATEWAY_UPSTREAM_URL=
# Daily spending cap across all jobs, USD (default 200). An alert fires at 80 %.
# The per-job budget is OPS.agentBudgetUsdPerJob (15 USD), recorded in jobs.api_cost_usd.
# The daily total (UTC day) is kept in memory; after a restart it starts again from the sum of
# jobs.api_cost_usd of the jobs updated today, an approximation from above (a job that spent
# today counts in full). Until that sum can be read, the gateway refuses requests.
FORGE_GATEWAY_DAILY_BUDGET_USD=200

# --- Site-coding agent (runs in the sandbox, reaches the gateway only) ------------------------
# Must be a model priced by the gateway (src/gateway/config.ts). Default claude-sonnet-5-5.
BUILDER_AGENT_MODEL=
# CLI binary inside the sandbox image (default claude).
BUILDER_AGENT_BIN=
# Default 80 turns, 2048 MB, 2 CPUs. Timeout: OPS.agentTimeoutMinutes (30 min).
BUILDER_AGENT_MAX_TURNS=
BUILDER_AGENT_MEMORY_MB=
BUILDER_AGENT_CPUS=
# Second agent pass on screenshots of new sites (src/pipeline/review): off (default) or on.
BUILDER_VISUAL_REVIEW=off

# --- Sandbox (apps/builder/docker/README.md) --------------------------------------------------
# Pinned image ids printed by docker/build-images.sh (sha256:... or name@sha256:...).
FORGE_SANDBOX_IMAGE=
FORGE_SANDBOX_PROXY_IMAGE=
# Visual review image (docker/review.Dockerfile), pinned like the others. Needed by
# BUILDER_VISUAL_REVIEW=on (without it the review stays off, with a warning at start-up).
FORGE_SANDBOX_REVIEW_IMAGE=
# Absolute folder; job folders are created strictly inside it (size-limited filesystem).
FORGE_SANDBOX_JOBS_ROOT=
# Gateway as seen from the egress proxy, host:port (required: the agent reaches the gateway
# through it), e.g. host.docker.internal:8787.
FORGE_SANDBOX_GATEWAY_UPSTREAM=
# runc (default) or runsc (gVisor, recommended).
FORGE_SANDBOX_RUNTIME=
# Sandbox user. Run the builder as this uid (or as root: job folders are then chowned to it).
FORGE_SANDBOX_UID=
FORGE_SANDBOX_GID=
# docker CLI path (default docker).
FORGE_DOCKER_BIN=
# No registry token: @forge/core and @forge/shared install from the public npm registry as
# npm:@forgedevv/core and npm:@forgedevv/shared (exact versions). Do not set any npm or GitHub
# Packages token here: the builder never uses one and never copies one to a client project.

# --- GitHub App (src/github.ts): repo-scoped installation tokens ------------------------------
# The App also reads the files each Vercel deployment uploads (contents: read, one repo per
# token): Vercel itself is never given access to the organization.
GITHUB_APP_ID=
GITHUB_ORG=
# The PEM key: a file path (preferred) or inline (\n escapes accepted).
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_APP_PRIVATE_KEY=
# Template repository in the org (default launchpad-template).
GITHUB_TEMPLATE_REPO=
# Extra repositories the builder must never touch, comma-separated (the FORGE monorepo is
# always refused).
GITHUB_REPO_DENYLIST=

# --- Vercel (src/vercel.ts): one project per client, git deployments off -----------------------
# Projects are not linked to GitHub: each deployment uploads the files of one commit through the
# REST API. No Vercel GitHub app is needed on the organization, so the Hobby plan's refusal of
# private organization repositories does not apply.
VERCEL_TOKEN=
# Team id (team_...) or, failing that, the team slug.
VERCEL_TEAM_ID=
VERCEL_TEAM=
# Client sites are served at <slug>.<CLIENTS_DOMAIN> (a domain separate from FORGE's).
CLIENTS_DOMAIN=

# --- Public variables copied into every client project (D21: public values only) --------------
# FORGE addresses, checked at start-up by requireAddresses (@forge/core).
FORGE_MULTISIG_VAULT=
FORGE_METEORA_REFERRAL_ACCOUNT=
FORGE_PLATFORM_FEE_WALLET=
FORGE_JUPITER_REFERRAL_ACCOUNT=
# RPC relay of apps/web (https, no query string, never the provider URL itself).
NEXT_PUBLIC_FORGE_RPC_RELAY_URL=
# Public bucket URL for coin images (https, no credentials).
R2_PUBLIC_URL=
# Optional explicit twins read by the site in the browser; derived from the variables above when
# unset, and refused when set to a different value (the browser and the server must agree).
NEXT_PUBLIC_SOLANA_CLUSTER=
NEXT_PUBLIC_FORGE_JUPITER_REFERRAL_ACCOUNT=
NEXT_PUBLIC_FORGE_PLATFORM_FEE_WALLET=
NEXT_PUBLIC_FORGE_METEORA_REFERRAL_ACCOUNT=
NEXT_PUBLIC_R2_PUBLIC_URL=
# Not used by the builder and never sent to client projects (D21): RPC_URL, JUPITER_API_KEY,
# R2_ACCOUNT_ID, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY, R2_BUCKET.

# --- RPC relay token (src/relay-token.ts) -----------------------------------------------------
# Signs the per-launchpad server token FORGE_RPC_RELAY_TOKEN of each client project (sensitive,
# server-only). At least 32 bytes, same value as on the web side. Never sent to client projects.
RPC_RELAY_TOKEN_SECRET=

# --- Signer (src/signer-client.ts): HMAC-signed private API -----------------------------------
SIGNER_URL=
# At least 32 bytes, same value as on the signer.
SIGNER_HMAC_SECRET=
# Per-request timeout, ms (default 120000: the configs route waits for confirmations).
SIGNER_TIMEOUT_MS=

# --- Sleep mode (src/sleep.ts) -----------------------------------------------------------------
# Daily cycle: launchpads with no trade and no job for 30 days go to sleep. true | false.
BUILDER_SLEEP_ENABLED=true
BUILDER_SLEEP_INTERVAL_HOURS=24
# Disabled launchpads (launchpads.status = 'disabled'): their sites are cut at startup, before
# every sleep cycle and every N minutes (default 15), whether sleep mode is enabled or not.
BUILDER_DISABLED_SWEEP_MINUTES=15

# --- Alerts (Telegram) -------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
