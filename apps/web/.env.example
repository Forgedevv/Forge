SOLANA_CLUSTER=
RPC_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
FORGE_MINT=
FORGE_GATING_AMOUNT=
FORGE_CASHBOX_WALLET=
JUPITER_API_KEY=
# Guard of the SOL/USD rate of payment quotes: bounds in dollars per SOL (defaults 10 and 2000)
# and the largest move from the last accepted rate, in percent (default 25). A rate outside them is
# refused with a retryable 503 PRICE_UNAVAILABLE and no quote is handed out.
SOL_USD_PRICE_MIN=
SOL_USD_PRICE_MAX=
SOL_USD_PRICE_MAX_DEVIATION_PCT=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
NEXT_PUBLIC_USE_MOCKS=1
# Public URL of the site; its host is the sign-in domain (http://localhost:3000 in development).
NEXT_PUBLIC_APP_URL=
# At least 32 bytes each, e.g. `openssl rand -base64 48`. Server only.
SESSION_SECRET=
SUPABASE_JWT_SECRET=

# --- RPC relay (POST /api/rpc, server only) ---
# Upstream provider URL of the public relay only: https, on the SOLANA_CLUSTER network (a devnet
# host contains "devnet"), with its own provider key so relay traffic never spends the quota of the
# payment and launch routes, which use RPC_URL. REQUIRED when NODE_ENV=production or
# SOLANA_CLUSTER=mainnet-beta: without it the relay answers 503 and logs a configuration error
# (the variable name, never the URL). Only local development falls back to RPC_URL.
RPC_RELAY_UPSTREAM_URL=
# Callers with neither an Origin header nor a server token: `on` or `off`. Default `off` when
# NODE_ENV=production or SOLANA_CLUSTER=mainnet-beta, `on` otherwise. When on, they only get the
# creator fee claim's methods and their own rate ceiling.
RPC_RELAY_ANONYMOUS=
# Total of the relay's per-class rate ceilings, units per minute (default 60000), split 25% FORGE
# site, 50% client sites, 15% server tokens, 10% anonymous. One class never spends another's.
# RPC_RELAY_GLOBAL_{FORGE,SITES,SERVER,ANONYMOUS}_UNITS_PER_MINUTE override one class.
RPC_RELAY_GLOBAL_UNITS_PER_MINUTE=

# --- Launchpad coin metadata (GET /api/coin-meta/:slug, public, no session) ---
# The signer writes this route's URL into the on-chain metadata of every launchpad coin. In the
# SIGNER's environment (not this app's), set:
#   SIGNER_COIN_METADATA_URL=https://<host of this site>/api/coin-meta/{slug}
# The URI is immutable on-chain and must fit the launch transaction: with a 32-byte slug it must
# stay under about 106 bytes, so the host must be at most about 50 characters. Never change the
# host or the path once coins point to it.
# Client sites live at https://<slug>.<CLIENTS_DOMAIN> (also the metadata `external_url`).
CLIENTS_DOMAIN=

# --- Browser (public, inlined at build time) ---
# Supabase project URL and anon key (same values as SUPABASE_URL / SUPABASE_ANON_KEY): Realtime
# updates and RLS-scoped reads in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Same value as SOLANA_CLUSTER (`devnet` or `mainnet-beta`). Explorer links follow it; a production
# build without it links to mainnet, never to devnet.
NEXT_PUBLIC_SOLANA_CLUSTER=
# Public FORGE cashbox address (same value as FORGE_CASHBOX_WALLET). When set, the browser refuses
# to sign a payment whose recipient is not this address.
NEXT_PUBLIC_FORGE_CASHBOX_WALLET=
