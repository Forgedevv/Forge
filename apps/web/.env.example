# The server configuration is checked when a server instance starts (instrumentation.ts): every
# problem is logged by variable name (`server_not_ready`, scope `readiness`), never by value, and
# GET /api/health answers 503 `{ ok: false, code }` until it is fixed (200 `{ ok: true }` then).
SOLANA_CLUSTER=
RPC_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
FORGE_MINT=
FORGE_GATING_AMOUNT=
FORGE_CASHBOX_WALLET=
JUPITER_API_KEY=
# Guard of the SOL/USD rate of payment quotes: bounds in dollars per SOL (defaults 10 and 5000)
# and the largest move from the last accepted rate, in percent (default 25). A rate outside them is
# refused with a retryable 503 PRICE_UNAVAILABLE and no quote is handed out. The signer's payment
# floors (SIGNER_MIN_*_PAYMENT_LAMPORTS) are derived from the 5000 bound: raising SOL_USD_PRICE_MAX
# above it needs lower floors on the signer first, or legitimate payments are refused there.
SOL_USD_PRICE_MIN=
SOL_USD_PRICE_MAX=
SOL_USD_PRICE_MAX_DEVIATION_PCT=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
# Optional: S3 endpoint of the bucket, https with no path. Default
# https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com, which is right for Cloudflare R2: leave it unset
# unless the bucket sits behind another endpoint.
R2_ENDPOINT=
# Development only, never set in production (mainnet included): the UI's simulated-data mode for
# the /dev pages, with no wallet or API. It is ignored in a production build, but keep it out of
# the production environment all the same. Left commented out so a copy of this file does not
# switch it on; to use it, pass it on the command line (see src/ui/workspace/README.md):
#   NEXT_PUBLIC_USE_MOCKS=1 pnpm --filter @forge/web dev --port 3007
# NEXT_PUBLIC_USE_MOCKS=1
# Public URL of the site; its host is the sign-in domain (http://localhost:3000 in development).
NEXT_PUBLIC_APP_URL=
# At least 32 bytes each, e.g. `openssl rand -base64 48`. Server only.
SESSION_SECRET=
SUPABASE_JWT_SECRET=

# --- Private beta (server only) ---
# `on` (closed beta: only the wallets of FORGE_BETA_ALLOWLIST may sign in) or `off` (public).
# Default when unset: `on` in a production build, `off` otherwise. Any other value closes sign-in
# for everybody. Mainnet: start with `on` and the team wallets, open to the public later.
FORGE_BETA_MODE=
# Comma-separated base58 wallet addresses (at most 10,000), REQUIRED while the beta is on, so
# REQUIRED in production unless FORGE_BETA_MODE=off. Without a valid list (empty, or one invalid
# entry) nobody can sign in and GET /api/health answers 503. Re-read on every request: an updated
# list applies without a restart.
FORGE_BETA_ALLOWLIST=

# --- Internal jobs (server only) ---
# Optional, at least 32 bytes (`openssl rand -base64 48`). Bearer secret of POST
# /api/internal/uploads/sweep, the scheduled sweep of the coin uploads (call it about every 15
# minutes). Without it the route answers 503 (disabled) and uploads that were never attached to a
# launch are not cleaned up; a missing or wrong secret in the request is a 401. Set on this web
# project only. Recommended on mainnet.
FORGE_INTERNAL_CRON_SECRET=

# --- Design chat tunables (optional, positive numbers; an empty or invalid value uses the default) ---
# The model spend is bounded in dollars per conversation and per wallet per rolling 24 hours, and
# messages are bounded per wallet and per IP. Raise them only on purpose: they cap what the
# Anthropic key can cost.
# Total model spend of one conversation, in USD (default 1).
CHAT_CONVERSATION_COST_CAP_USD=
# Model spend of one wallet over a rolling 24 hours, in USD (default 5).
CHAT_WALLET_DAILY_COST_CAP_USD=
# Messages per wallet in 10 minutes (default 15) and per day (default 150).
CHAT_WALLET_MESSAGES_PER_10_MIN=
CHAT_WALLET_MESSAGES_PER_DAY=
# Messages per IP in 10 minutes (default 40).
CHAT_IP_MESSAGES_PER_10_MIN=

# --- RPC relay (POST /api/rpc, server only) ---
# Upstream provider URL of the public relay only: https, on the SOLANA_CLUSTER network (a devnet
# host contains "devnet"), with its own provider key so relay traffic never spends the quota of the
# payment and launch routes, which use RPC_URL. REQUIRED when NODE_ENV=production or
# SOLANA_CLUSTER=mainnet-beta: without it the relay answers 503 and logs a configuration error
# (the variable name, never the URL). Only local development falls back to RPC_URL.
RPC_RELAY_UPSTREAM_URL=
# Callers with neither an Origin header nor a server token: `on` or `off`. Default `off` when
# NODE_ENV=production or SOLANA_CLUSTER=mainnet-beta, `on` otherwise. When on, they only get the
# creator fee claim's methods and their own rate ceiling.
RPC_RELAY_ANONYMOUS=
# Optional, at least 32 bytes (`openssl rand -base64 48`). Secret of the per-launchpad server token
# (header X-Forge-Relay-Token) that the code of client sites sends to the relay and to the coin
# upload routes. It MUST be the same value as RPC_RELAY_TOKEN_SECRET of the builder, which derives
# each site's token from it: with a different value the server routes of client sites are
# refused. Needed on mainnet since the builder requires it. Unset: the server-token tier is off;
# too short: GET /api/health answers 503. Server only; never put it in a client project.
RPC_RELAY_TOKEN_SECRET=
# Total of the relay's per-class rate ceilings, units per minute (default 60000), split 25% FORGE
# site, 50% client sites, 15% server tokens, 10% anonymous. One class never spends another's.
# RPC_RELAY_GLOBAL_{FORGE,SITES,SERVER,ANONYMOUS}_UNITS_PER_MINUTE override one class.
RPC_RELAY_GLOBAL_UNITS_PER_MINUTE=

# --- Launchpad coin metadata (GET /api/coin-meta/:slug, public, no session) ---
# The signer writes this route's URL into the on-chain metadata of every launchpad coin. In the
# SIGNER's environment (not this app's), set:
#   SIGNER_COIN_METADATA_URL=https://<host of this site>/api/coin-meta/{slug}
# The URI is immutable on-chain and must fit the launch transaction: with a 32-byte slug it must
# stay under about 106 bytes, so the host must be at most about 50 characters. Never change the
# host or the path once coins point to it.
# Client sites live at https://<slug>.<CLIENTS_DOMAIN> (also the metadata `external_url`).
CLIENTS_DOMAIN=

# --- Browser (public, inlined at build time) ---
# Supabase project URL and anon key (same values as SUPABASE_URL / SUPABASE_ANON_KEY): Realtime
# updates and RLS-scoped reads in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Same value as SOLANA_CLUSTER (`devnet` or `mainnet-beta`), required in production. Explorer links
# follow it; a production build without it links to mainnet, never to devnet. A bundle built with
# another value, or without it in production, makes GET /api/health answer 503 cluster_mismatch.
NEXT_PUBLIC_SOLANA_CLUSTER=
# Public FORGE cashbox address (same value as FORGE_CASHBOX_WALLET). When set, the browser refuses
# to sign a payment whose recipient is not this address.
NEXT_PUBLIC_FORGE_CASHBOX_WALLET=
# Support contact shown wherever a client may need the team (payment that needs help, failed build,
# error notices, private beta notice, FAQ). Both optional; set either or both. The Telegram link
# must be https on t.me or telegram.me (e.g. https://t.me/forge_support); the email a plain
# address. An invalid value counts as unset. With neither set, the screens point to the FAQ.
NEXT_PUBLIC_SUPPORT_TELEGRAM_URL=
NEXT_PUBLIC_SUPPORT_EMAIL=
