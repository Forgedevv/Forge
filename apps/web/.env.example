SOLANA_CLUSTER=
RPC_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
FORGE_MINT=
FORGE_GATING_AMOUNT=
FORGE_CASHBOX_WALLET=
JUPITER_API_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
NEXT_PUBLIC_USE_MOCKS=1
# Public URL of the site; its host is the sign-in domain (http://localhost:3000 in development).
NEXT_PUBLIC_APP_URL=
# At least 32 bytes each, e.g. `openssl rand -base64 48`. Server only.
SESSION_SECRET=
SUPABASE_JWT_SECRET=

# --- RPC relay (POST /api/rpc, server only) ---
# Upstream provider URL of the public relay only: https, on the SOLANA_CLUSTER network (a devnet
# host contains "devnet"). Recommended in production: a separate provider key, so relay traffic
# never spends the quota of the payment and launch routes, which use RPC_URL. When empty the relay
# falls back to RPC_URL and logs a warning at startup in production (the variable name, never the
# URL).
RPC_RELAY_UPSTREAM_URL=

# --- Browser (public, inlined at build time) ---
# Supabase project URL and anon key (same values as SUPABASE_URL / SUPABASE_ANON_KEY): Realtime
# updates and RLS-scoped reads in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Same value as SOLANA_CLUSTER (`devnet` or `mainnet-beta`). Explorer links follow it; a production
# build without it links to mainnet, never to devnet.
NEXT_PUBLIC_SOLANA_CLUSTER=
# Public FORGE cashbox address (same value as FORGE_CASHBOX_WALLET). When set, the browser refuses
# to sign a payment whose recipient is not this address.
NEXT_PUBLIC_FORGE_CASHBOX_WALLET=
