{
  "name": "@forge/core",
  "version": "0.1.0",
  "private": true,
  "description": "FORGE transaction core: Meteora Dynamic Bonding Curve configs, pools, swaps, claims and on-chain checks. Published on npm as @forgedevv/core.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Forgedevv/Forge.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/Forgedevv/Forge/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/Forgedevv/Forge/issues"
  },
  "keywords": [
    "solana",
    "meteora",
    "dynamic-bonding-curve",
    "launchpad"
  ],
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./launch-check": {
      "types": "./dist/launch-check.d.ts",
      "default": "./dist/launch-check.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "!dist/**/*.test.*",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint .",
    "publish:npm": "node ../../scripts/publish-core.mjs"
  },
  "dependencies": {
    "@forge/shared": "workspace:*",
    "@meteora-ag/dynamic-bonding-curve-sdk": "1.5.13",
    "@solana/spl-token": "0.4.15",
    "@solana/web3.js": "1.99.0",
    "bn.js": "5.2.5"
  },
  "devDependencies": {
    "@types/bn.js": "5.2.0",
    "@types/node": "26.6.4"
  }
}
