{
  "name": "@forge/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./launch-check": {
      "types": "./dist/launch-check.d.ts",
      "default": "./dist/launch-check.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint .",
    "publish:packages": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run build && pnpm publish --registry https://npm.pkg.github.com --access restricted"
  },
  "dependencies": {
    "@forge/shared": "workspace:*",
    "@meteora-ag/dynamic-bonding-curve-sdk": "1.5.13",
    "@solana/spl-token": "0.4.15",
    "@solana/web3.js": "1.99.0",
    "bn.js": "5.2.5"
  },
  "devDependencies": {
    "@types/bn.js": "5.2.0",
    "@types/node": "26.6.4"
  }
}
